# --- Bright Data (control panel → account settings → API token) ---
BRIGHTDATA_API_TOKEN=your_brightdata_api_token

# Zone names from your Bright Data control panel (create one of each):
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
BRIGHTDATA_SERP_ZONE=serp_api1

# --- Anthropic (for the analysis/clustering step) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- optional: Web Scraper API dataset for Google Play reviews (default is the library id) ---
